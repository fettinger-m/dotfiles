#!/usr/bin/env bash

# Change standard program for file ending
# Arg 1  is file ending e.g. "pdf", Arg 2 is app name e.g. "Preview"
function cfe() {
    local id=$(osascript -e "id of app \"$2\"")
    duti -s "$id" .$1 all
}

# Change working directory to the top-most Finder window location
function cdf() { # short for `cdfinder`
	cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')";
}


mkcd ()
{
    mkdir -p -- "$1" &&
       cd -P -- "$1"
}

compress_pdf() {
  local input_file="$1"
  local quality="${2:-screen}"
  local output_file

  if [[ -z "$input_file" ]]; then
    print -u2 "usage: compress_pdf <input.pdf> [screen|ebook|printer|prepress|default]"
    return 2
  fi

  if ! command -v gs >/dev/null 2>&1; then
    print -u2 "compress_pdf: gs (Ghostscript) not found"
    return 127
  fi

  if [[ ! -r "$input_file" ]]; then
    print -u2 "compress_pdf: cannot read file: $input_file"
    return 1
  fi

  output_file="${input_file%.*}_compressed.pdf"

  gs -sDEVICE=pdfwrite \
     -dCompatibilityLevel=1.4 \
     -dPDFSETTINGS=/"$quality" \
     -dNOPAUSE \
     -dQUIET \
     -dBATCH \
     -sOutputFile="$output_file" \
     "$input_file"
}
