{
  // Zen Mode
  "editor.minimap.enabled": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.verticalScrollbarSize": 0,
  "window.dialogStyle": "custom",
  "window.title": "${activeEditorMedium}",
  "window.commandCenter": false,
  "window.density.editorTabHeight": "compact",
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "hidden",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.sideBar.location": "right",
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "breadcrumbs.enabled": false,
  "editor.glyphMargin": false,
  // "workbench.editor.showTabs": "none",

  // Visuals
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.fontAliasing": "antialiased",
  "editor.fontFamily": "IBMPlexMono, monospace",
  "workbench.colorTheme": "Gruvbox Dark Medium",
  "workbench.productIconTheme": "icons-carbon",

  // Editor
  "workbench.startupEditor": "none",
  "workbench.settings.editor": "json",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 5,
  "explorer.excludeGitIgnore": true,

  // Saving and Formatting
  "files.autoSave": "onWindowChange",
  "editor.formatOnSave": true,

  "chat.commandCenter.enabled": false,
  // Language Specific Settings
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
  },
  // PYTHON / JUPYTER
  "notebook.consolidatedOutputButton": false,
  "notebook.globalToolbarShowLabel": "never",
  "notebook.markup.fontSize": 12,
  "python.defaultInterpreterPath": "/opt/homebrew/Caskroom/miniconda/base/bin/python",

  // LATEX
  "[latex]": {
    "editor.suggest.showWords": false,
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "editor.tabSize": 2,
  },
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.formatting.latex": "tex-fmt",
  "latex-workshop.intellisense.subsuperscript.enabled": true,
  "latex-workshop.intellisense.argumentHint.enabled": false,
  "latex-workshop.view.pdf.color.dark.backgroundColor": "#282C34",
  "latex-workshop.view.pdf.color.dark.pageBorderColor": "#282C34",
  "git.confirmSync": false,
  "workbench.editor.languageDetection": false,
  "github.copilot.nextEditSuggestions.enabled": false,
  "[r]": {
    "editor.wordWrap": "on",
  },
  "[rmd]": {
    "editor.wordWrap": "on",
  },
  "[css]": {
    "editor.wordWrap": "off",
  },
  "notebook.defaultFormatter": "ms-python.black-formatter",
  "notebook.formatOnSave.enabled": true,
}
